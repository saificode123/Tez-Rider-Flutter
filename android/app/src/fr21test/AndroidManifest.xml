<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application>
        <meta-data android:name="firebase_messaging_installation_id_enabled" android:value="true"/>
        <activity android:name=".MainActivity">
            <!-- Supabase's existing app_links integration consumes Auth callbacks. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false"/>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="tezrider-fr21-test" android:host="login-callback" android:path="/"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
