# Flutter compile-time configuration; NOT a runtime asset.
# Copy to .env, obtain the authorized TEST public key privately, then rebuild:
# flutter run --flavor fr21test -t lib/main.dart --dart-define-from-file=.env
SUPABASE_URL=https://igeisilhtmglgnqvllrx.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_APPROVED_TEST_PUBLIC_KEY
# Legacy SUPABASE_ANON_KEY is also supported. Set only one key name.
FR21_ISOLATED_TEST=true
# Requires the approved TEST google-services.json at the flavor-specific path.
FR30_ANDROID_PUSH=true
FR30_FIREBASE_PROJECT_ID=tez-rider-fe12b
# No routing, SMTP, service-role, FCM server, database or email-provider secrets.
# Authentication, Storage, Realtime and email/route Edge Functions use Supabase.
